      "parameters": {
        "where": "1=1",
        "geometry": "-3.75,56.052,-3.68,56.095",
        "geometryType": "esriGeometryEnvelope",
        "inSR": "4326",
        "outSR": "4326",
        "spatialRel": "esriSpatialRelIntersects",
        "outFields": "*",
        "returnGeometry": "true",
        "f": "geojson"
      }
    },
